# .env.example — copy to .env and fill in local values

# Application
APP_ENV=development
LOG_LEVEL=INFO

# LLM (
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b

# GPU VM Backend
API_KEY=change-me
BACKEND_PORT=8080


# Robot connection
REACHY_HOST=localhost
REACHY_PORT=5000

# Retrieval / RAG
RAG_SOURCES_DIR=./data/rag_sources
RAG_INDEX_DIR=./data/rag_index
