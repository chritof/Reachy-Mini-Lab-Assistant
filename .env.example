# Kopier denne filen til .env og fyll inn lokale verdier.

# OpenAI Realtime
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_LANGUAGE=no
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_INPUT_SAMPLE_RATE=24000
OPENAI_REALTIME_OUTPUT_SAMPLE_RATE=24000
OPENAI_REALTIME_VAD_THRESHOLD=0.72
OPENAI_REALTIME_VAD_SILENCE_MS=950
OPENAI_REALTIME_VAD_PREFIX_PADDING_MS=180
OPENAI_REALTIME_WAKE_PHRASE_TIMEOUT_SEC=20.0

# Lokal RAG
RAG_SOURCES_DIR=./data/rag_sources
RAG_OPENAI_STORE_DIR=./data/rag_openai_store
RAG_OPENAI_EMBED_MODEL=text-embedding-3-small
