# .env.example — copy to .env and fill in local values

# Application
APP_ENV=development
LOG_LEVEL=INFO

# LLM (
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b


# OpenAI Realtime
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_LANGUAGE=no
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_INPUT_SAMPLE_RATE=24000
OPENAI_REALTIME_OUTPUT_SAMPLE_RATE=24000



# Retrieval / RAG
RAG_SOURCES_DIR=./data/rag_sources
RAG_INDEX_DIR=./data/rag_index
